APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Docker Compose: usar 'postgres' (nombre del servicio en docker-compose.yml)
# Fuera de Docker: usar '127.0.0.1' o el host real
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hubdigital
DB_USERNAME=postgres
DB_PASSWORD=
# Docker Compose: usar 'disable' (la red interna no necesita SSL)
DB_SSLMODE=disable

# Base de datos local para tests de integración (NO usar Supabase)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_DATABASE=hubdigital
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

    # Cuenta administrativa de curaduría que siembra CuradorSeeder.
# CURADOR_PASS es obligatoria: sin ella el seeder aborta en vez de usar una por defecto.
CURADOR_EMAIL=curador@epn.edu.ec
CURADOR_PASS=

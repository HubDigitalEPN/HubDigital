APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
HUBDIGITAL_ALLOW_AUTH_EMAILS=false
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

# Cloudflare Turnstile protege el inicio de sesión. En producción usa un widget
# administrado para dev.labinvepn.org; localhost y 127.0.0.1 se usan en desarrollo.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_EXPECTED_HOSTNAME=dev.labinvepn.org

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Docker Compose: usar 'postgres' (nombre del servicio en docker-compose.yml)
# Fuera de Docker: usar '127.0.0.1' o el host real
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hubdigital
DB_USERNAME=postgres
DB_PASSWORD=
# Docker Compose: usar 'disable' (la red interna no necesita SSL)
DB_SSLMODE=disable

# Base de datos local para tests de integración (NO usar Supabase)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_DATABASE=hubdigital
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
AUTH_REMEMBER_LIFETIME=43200
AUTH_API_TOKEN_LIFETIME=480
AUTH_VERIFICATION_EXPIRE=60
AUTH_PASSWORD_TIMEOUT=900
AUTH_INTERNAL_EMAIL_DOMAINS=epn.edu.ec

# Alta inicial web de un solo uso (solo desarrollo). Usar secretos efímeros,
# fecha ISO-8601 futura y deshabilitar tras la prueba. Nunca usar en producción.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_EXPIRES_AT=
ADMIN_BOOTSTRAP_EMAIL=adrian.troya@epn.edu.ec
ADMIN_BOOTSTRAP_ALLOWED_HOSTS=localhost,127.0.0.1,dev.labinvepn.org
ADMIN_BOOTSTRAP_ALLOWED_ENVIRONMENTS=local,development,testing

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DEPOSIT_STORAGE_DRIVER=auto
DEPOSIT_STORAGE_REQUIRE_REMOTE=false
DEPOSIT_STORAGE_VERIFY_AFTER_WRITE=true
DEPOSIT_STORAGE_MAX_OBJECT_BYTES=26214400
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
DOCUMENT_EXTRACTION_DRIVER=local
DOCUMENT_EXTRACTION_OCR_LANGUAGES=spa+eng
# En produccion no desactivar: exige que pdfsig reconozca la cadena de confianza.
FIRMA_EXIGIR_CERTIFICADO_CONFIABLE=true
# Base NSS con las raíces/intermedias acreditadas. pdfsig consulta OCSP por defecto.
FIRMA_NSS_DIR=
FIRMA_MAX_PAGES=200
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Desarrollo sin entrega: log. Para entrega real con Zoho usa smtp, el servidor
# que muestra la cuenta Zoho (smtp.zoho.com o smtppro.zoho.com) y puerto 587.
# MAIL_PASSWORD debe ser una contraseña de aplicación y nunca se versiona.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hubdigital.epn@kintiflow.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Web Push PWA. Generar una sola vez con `php artisan webpush:vapid` y guardar
# la clave privada exclusivamente como secreto del entorno.
VAPID_SUBJECT=https://labinvepn.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBPUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,web.push.apple.com,.notify.windows.com

# Solo desarrollo: habilita tres cuentas desechables para la prueba integral.
SEED_DEMO_USERS=false
DEMO_DEPOSITOS_PASSWORD=
# Se puede activar también en OCI; la contraseña se define solo en el entorno.
SEED_BOOTSTRAP_DEPOSITANTE=false
BOOTSTRAP_DEPOSITANTE_EMAIL=hernan.troya@yahoo.com
BOOTSTRAP_DEPOSITANTE_PASSWORD=

# Cloudflare Tunnel (solo desarrollo/revisión remota; nunca versionar el token real)
CLOUDFLARE_TUNNEL_TOKEN=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Asistente ligero: reglas y PostgreSQL, sin modelo residente.
CHAT_ENABLED=true
CHAT_SPECIMEN_SEARCH=true
CHAT_STATISTICAL_RANKING=true
CHAT_DEBUG=false
CHAT_SEMANTIC_ENABLED=false

    # Cuenta administrativa de curaduría que siembra CuradorSeeder.
# CURADOR_PASS es obligatoria: sin ella el seeder aborta en vez de usar una por defecto.
CURADOR_EMAIL=curador@epn.edu.ec
CURADOR_PASS=

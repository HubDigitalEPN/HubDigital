[Unit]
Description=HubDigital database queue worker (one serialized worker)
After=network-online.target postgresql@16-main.service php8.4-fpm.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/hubdigital/current
EnvironmentFile=/etc/hubdigital/hubdigital.env
ExecStart=/usr/bin/bash /srv/hubdigital/current/deploy/oracle/scripts/run-queue-worker.sh
Restart=always
RestartSec=10s
TimeoutStopSec=330s
MemoryAccounting=true
MemoryMax=256M
CPUAccounting=true
NoNewPrivileges=true
PrivateTmp=true
LimitCORE=0
UMask=0077

[Install]
WantedBy=multi-user.target

[Unit]
Description=HubDigital prepared PDF signature and verification engine
After=local-fs.target network.target run-hubdigital.mount
Requires=run-hubdigital.mount

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/hubdigital/current
Environment=HUBDIGITAL_SIGNATURE_TRUST_DIR=/srv/hubdigital/current/resources/signature-trust
ExecStart=/usr/bin/java -Djava.awt.headless=true -Djava.io.tmpdir=/run/hubdigital/document-processing -Dhubdigital.revocation.timeout=2 -Dcom.sun.security.ocsp.timeout=2 -Dcom.sun.security.crl.timeout=2 -Dsun.net.client.defaultConnectTimeout=2000 -Dsun.net.client.defaultReadTimeout=2000 -Xms24m -Xmx160m -XX:+UseSerialGC -XX:ActiveProcessorCount=2 -jar /srv/hubdigital/current/resources/bin/hubdigital-pdf-signature.jar serve /run/hubdigital-signature/firmador.sock
Restart=on-failure
RestartSec=1s
RuntimeDirectory=hubdigital-signature
RuntimeDirectoryMode=0700
MemoryAccounting=true
MemoryMax=320M
CPUAccounting=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/hubdigital/document-processing
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
UMask=0077

[Install]
WantedBy=multi-user.target

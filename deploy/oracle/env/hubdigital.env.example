# Copiar como /etc/hubdigital/hubdigital.env (0600 root:www-data).
# Sustituir solo los marcadores entre <> en un gestor de secretos; no versionar
# ese archivo. En una instalacion nueva se genera APP_KEY una sola vez y se
# conserva para todos los despliegues posteriores.
APP_NAME=HubDigital
APP_ENV=production
APP_KEY=<APP_KEY_ORIGINAL>
APP_DEBUG=false
APP_URL=https://dev.labinvepn.org
# Nginx termina TLS y sobrescribe las cabeceras reenviadas en el limite de
# confianza. No se confian proxies arbitrarios desde la aplicacion.
TRUSTED_PROXIES=
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning
# Debe mantenerse en true durante restauracion, pruebas internas y mediciones.
# Bloquea canales externos de Laravel Notification; el canal database permanece.
HUBDIGITAL_VALIDATION_MODE=true
# En validacion solo se autoriza el correo VerifyEmail; el resto de canales
# externos permanece bloqueado por AppServiceProvider.
HUBDIGITAL_ALLOW_AUTH_EMAILS=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hubdigital_pruebas
DB_USERNAME=hubdigital_pruebas_app
DB_PASSWORD=<POSTGRES_PASSWORD>
DB_SSLMODE=disable
DB_SEARCH_PATH=public

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
QUEUE_FAILED_DRIVER=database-uuids
# En validación el worker consume sólo esta cola. Los trabajos restaurados de
# `default` no se ejecutan hasta que se revisen o se restauren expresamente.
HUBDIGITAL_VALIDATION_QUEUE=validation
# Se cambia a true sólo después de revisar schedule:list y los efectos de cada
# tarea; activate-release.sh nunca inicia el scheduler.
HUBDIGITAL_SCHEDULER_REVIEWED=false

# No existe fallback documental en Oracle.
DEPOSIT_STORAGE_DRIVER=r2
DEPOSIT_STORAGE_REQUIRE_REMOTE=true
DEPOSIT_STORAGE_VERIFY_AFTER_WRITE=true
DEPOSIT_STORAGE_MAX_OBJECT_BYTES=26214400
R2_ACCOUNT_ID=<R2_ACCOUNT_ID>
R2_BUCKET=<R2_BUCKET>
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Separa los objetos de pruebas nuevas de los historicos sin usar disco local.
DEPOSIT_STORAGE_PREFIX=pruebas-oracle-20260920

# Los directorios bajo /run son temporales; no son repositorios de documentos.
HUBDIGITAL_EPHEMERAL_PATH=/run/hubdigital
HUBDIGITAL_TEMPORARY_DIRECTORY=/run/hubdigital/document-processing
HUBDIGITAL_TEMPORARY_MIN_FREE_BYTES=67108864
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=ephemeral
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DIRECTORY=livewire-tmp

DOCUMENT_EXTRACTION_DRIVER=local
DOCUMENT_EXTRACTION_OCR_LANGUAGES=spa+eng
DOCUMENT_EXTRACTION_OCR_MAX_PAGES=25
DOCUMENT_EXTRACTION_OCR_DPI=200
DOCUMENT_EXTRACTION_MAX_RENDER_PIXELS=120000000
JAVA_BINARY=java
JAVA_SIGNATURE_TIMEOUT=60
FIRMA_MAX_PAGES=40

# SMTP Zoho queda activo para las verificaciones de alta autorizadas incluso
# durante la validacion; MAIL_PASSWORD es una contrasena de aplicacion secreta.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=hubdigital.epn@kintiflow.com
MAIL_PASSWORD=<CONTRASENA_DE_APLICACION_ZOHO>
MAIL_FROM_ADDRESS=hubdigital.epn@kintiflow.com
MAIL_FROM_NAME=HubDigital
VAPID_SUBJECT=https://dev.labinvepn.org
VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>

ADMIN_BOOTSTRAP_ENABLED=false
SEED_DEMO_USERS=false
SEED_BOOTSTRAP_DEPOSITANTE=true
BOOTSTRAP_DEPOSITANTE_EMAIL=hernan.troya@yahoo.com
BOOTSTRAP_DEPOSITANTE_PASSWORD=<CONTRASENA_DE_LA_CUENTA>
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=<turnstile-site-key>
TURNSTILE_SECRET=<turnstile-secret>
TURNSTILE_EXPECTED_HOSTNAME=dev.labinvepn.org

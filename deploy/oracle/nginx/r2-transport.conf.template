# Transporte local privado: conserva conexiones TLS, sin cachear objetos.
upstream hubdigital_r2_origin {
    server __R2_HOST__:443;
    keepalive 8;
    keepalive_timeout 60s;
    keepalive_requests 1000;
}
server {
    listen unix:/run/hubdigital/r2-transport/r2.sock;
    server_name __R2_HOST__;
    access_log off;
    client_max_body_size 64m;
    gzip off;
    location / {
        if ($host != __R2_HOST__) { return 421; }
        limit_except GET HEAD PUT DELETE { deny all; }
        proxy_pass https://hubdigital_r2_origin;
        proxy_http_version 1.1;
        proxy_set_header Host __R2_HOST__;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name __R2_HOST__;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 5;
        proxy_connect_timeout 3s;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
    }
}

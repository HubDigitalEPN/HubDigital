<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>Modules/InventarioGestionColeccion/tests/Unit</directory>
            <directory>Modules/CatalogoPublico/tests/Unit</directory>
            <directory>Modules/GestionPrestamosRecepciones/tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>tests/Regression</directory>
            <directory>Modules/CatalogoPublico/tests/Feature</directory>
            <directory>Modules/GestionPrestamosRecepciones/tests/Infrastructure</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>Modules/InventarioGestionColeccion/tests/Integration</directory>
            <directory>Modules/CatalogoPublico/tests/Integration</directory>
            <directory>Modules/GestionPrestamosRecepciones/tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="TURNSTILE_ENABLED" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="hubdigital"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_URL" value=""/>
        <env name="DB_SSLMODE" value="prefer"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>

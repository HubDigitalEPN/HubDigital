    {
      "name": "Solicitudes de prestamo",
      "item": [
        {
          "name": "Create Solicitud",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"investigador_id\": \"{{investigadorId}}\",\n  \"titulo_estudio\": \"{{solicitudTitulo}}\",\n  \"institucion_adscripcion\": \"{{solicitudInstitucion}}\",\n  \"linea_investigacion\": \"{{solicitudLineaInvestigacion}}\",\n  \"proposito_prestamo\": \"{{solicitudProposito}}\",\n  \"duracion_propuesta_meses\": {{solicitudDuracionMeses}},\n  \"items\": [\n    {\n      \"especimen_codigo_externo\": \"{{solicitudEspecimenCodigo}}\",\n      \"cantidad_solicitada\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/solicitudes-prestamo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "solicitudes-prestamo"
              ]
            },
            "description": "Creates a loan request and stores solicitudId from the response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var body = {};",
                  "try {",
                  "  body = pm.response.json();",
                  "} catch (error) {",
                  "  body = {};",
                  "}",
                  "var createdId = body.solicitud_id || body.id;",
                  "if (createdId) {",
                  "  pm.environment.set('solicitudId', createdId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Solicitud",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"investigador_id\": \"{{investigadorId}}\",\n  \"titulo_estudio\": \"{{solicitudTitulo}}\",\n  \"institucion_adscripcion\": \"{{solicitudInstitucion}}\",\n  \"linea_investigacion\": \"{{solicitudLineaInvestigacion}}\",\n  \"proposito_prestamo\": \"{{solicitudPropositoActualizado}}\",\n  \"duracion_propuesta_meses\": {{solicitudDuracionMeses}},\n  \"justificacion_extendida\": \"{{solicitudJustificacionExtendida}}\",\n  \"items\": [\n    {\n      \"id\": null,\n      \"especimen_codigo_externo\": \"{{solicitudEspecimenCodigo}}\",\n      \"cantidad_solicitada\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/solicitudes-prestamo/{{solicitudId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "solicitudes-prestamo",
                "{{solicitudId}}"
              ]
            },
            "description": "Updates the active solicitud using the id captured from the create request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Send Solicitud",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"investigador_id\": \"{{investigadorId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/solicitudes-prestamo/{{solicitudId}}/envios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "solicitudes-prestamo",
                "{{solicitudId}}",
                "envios"
              ]
            },
            "description": "Marks the solicitud as sent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload Signed Acta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "investigador_id",
                  "value": "{{investigadorId}}",
                  "type": "text"
                },
                {
                  "key": "pdf_firmado",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/solicitudes-prestamo/{{solicitudId}}/actas-firmadas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "solicitudes-prestamo",
                "{{solicitudId}}",
                "actas-firmadas"
              ]
            },
            "description": "Uploads the signed acta as multipart/form-data. Select a local PDF file in the pdf_firmado field before sending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        }
      ]

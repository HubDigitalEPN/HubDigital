        {
          "name": "Register Prestamista",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{prestamistaName}}\",\n  \"email\": \"{{prestamistaEmail}}\",\n  \"password\": \"{{prestamistaPassword}}\",\n  \"password_confirmation\": \"{{prestamistaPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/register/prestamista",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "register",
                "prestamista"
              ]
            },
            "description": "Creates a prestamista account and stores the returned token in authToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var body = {};",
                  "try {",
                  "  body = pm.response.json();",
                  "} catch (error) {",
                  "  body = {};",
                  "}",
                  "if (body.token) {",
                  "  pm.environment.set('authToken', body.token);",
                  "}"
                ]
              }
            }
          ]
        },

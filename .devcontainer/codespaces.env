APP_NAME="HubDigital EPN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://dev.labinvepn.org
TRUSTED_PROXIES=*

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_EC
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hubdigital
DB_USERNAME=hubdigital
DB_PASSWORD=hubdigital-dev-only
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
AUTH_REMEMBER_LIFETIME=43200
AUTH_API_TOKEN_LIFETIME=480
AUTH_VERIFICATION_EXPIRE=60
AUTH_PASSWORD_TIMEOUT=900
AUTH_INTERNAL_EMAIL_DOMAINS=epn.edu.ec

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DEPOSIT_STORAGE_DRIVER=auto
DEPOSIT_STORAGE_REQUIRE_REMOTE=false
DEPOSIT_STORAGE_VERIFY_AFTER_WRITE=true
DEPOSIT_STORAGE_MAX_OBJECT_BYTES=26214400
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
DOCUMENT_EXTRACTION_DRIVER=local
DOCUMENT_EXTRACTION_OCR_LANGUAGES=spa+eng
JAVA_BINARY=java
JAVA_SIGNATURE_TIMEOUT=60
FIRMA_MAX_PAGES=200
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@labinvepn.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

VAPID_SUBJECT=https://dev.labinvepn.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBPUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,web.push.apple.com,.notify.windows.com

# Se inyecta como secreto de Codespaces; nunca se escribe aquí.
CLOUDFLARE_TUNNEL_TOKEN=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CURADOR_EMAIL=adrian.troya@epn.edu.ec
CURADOR_PASS=
